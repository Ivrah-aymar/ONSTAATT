DATA TEMPDS;
INPUT ID NAME $ SALARY DEPARTMENT$ EXTDAY;
SAL_EXT=SALARY*0.033*EXTDAY;
LABEL ID = “EMP ID” SAL_EXT= ‘EXTRA HOURS PAY’;
DATALINES;
301 ABC 9500 RSA 3
302 EFG 6500 DGT 4
303 HIG 3200 DBT 2
304 TGH 5600 ITI 0
;
RUN;

PROC MEANS;
RUN;
 
PROC PRINT DATA=TEMPDS;
WHERE SALARY > 4000;
RUN;

